{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/mcp-schema.json",
  "mcpServers": {
    "graphify": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-m",
        "graphify.serve",
        "--graph",
        "E:/code/parking_management/graphify-out/graph.json"
      ],
      "env": {}
    }
  }
}
